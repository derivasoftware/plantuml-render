{
  "name": "plantuml-render",
  "version": "0.11.0",
  "description": "Deterministic SVG renderer: render-IR engine plus a PlantUML frontend built on tree-sitter-plantuml",
  "license": "MIT",
  "author": "dcoello-dev",
  "repository": "https://github.com/derivasoftware/plantuml-render",
  "type": "module",
  "main": "./out/render/index.js",
  "exports": {
    ".": "./out/render/index.js",
    "./browser": "./out/render/browser.js"
  },
  "bin": {
    "plantuml-render": "./out/render/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "doc/manual",
    "grammar",
    "out/**",
    "out/render",
    "schema",
    "schema/**"
  ],
  "scripts": {
    "compile": "node scripts/gen_schema.mjs && tsc -p ./ && cp src/render/validate.gen.js src/render/validate.gen.d.ts out/render/",
    "test": "npm run compile && vitest run",
    "eval": "tsc -p ./ && node scripts/eval_render.mjs",
    "prepare": "npm run compile",
    "test:ci": "npm run compile && vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml --coverage.enabled --coverage.provider=v8 --coverage.reporter=cobertura --coverage.reportsDirectory=test-results/coverage --coverage.include=src/** --coverage.exclude=src/**/*.gen.*",
    "binaries": "bash scripts/build_binaries.sh"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.17.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "config": {
    "grammar": "git+https://github.com/derivasoftware/tree-sitter-plantuml.git#v0.9.7"
  }
}
