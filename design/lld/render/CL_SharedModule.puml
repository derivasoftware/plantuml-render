@startuml CL_SharedModule
' requirement REQ-00002-1
' requirement REQ-00012-1
' requirement REQ-00015-1
' requirement REQ-00017-1

!startsub SharedModule

namespace render.shared {
  class esc <<function>> {
    + esc(text: string) : string
  }
  class idPrefix <<function>> {
    + idPrefix(title: string | undefined) : string
  }
  class memberMarkup <<function>> {
    + memberMarkup(line: string) : { visibility: string | undefined; inner: string }
  }
  class refAttrs <<function>> {
    + refAttrs(refs: Record<string, string | string[]> | undefined) : string
  }
  class linked <<function>> {
    + linked(href: string | undefined, markup: string) : string
  }
  class tooltip <<function>> {
    + tooltip(title: string | undefined) : string
  }
  class svgRoot <<function>> {
    + svgRoot(minX: number, minY: number, width: number, height: number) : string
  }
  class noticeMarkup <<function>> {
    + noticeMarkup(text: string, x: number, y: number) : { markup: string; w: number; h: number }
  }
}

!endsub

@enduml
